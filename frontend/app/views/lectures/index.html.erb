<% content_for(:title) { "LectureSnipe — Panopto Note Generator" } %>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">&#x26A1; Powered by AI</div>
    <h1 class="hero-title">
      Turn Lectures Into<br>
      <span class="gradient-text">Perfect Notes</span>
    </h1>
    <p class="hero-subtitle">
      Paste your Panopto URL and let LectureSnipe transform video lectures into
      clean, organized, beautifully formatted notes in seconds.
    </p>
    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-number">3</span>
        <span class="stat-label">Output Formats</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">&#x2713;</span>
        <span class="stat-label">Speaker Detection</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">&#x2713;</span>
        <span class="stat-label">Slide Extraction</span>
      </div>
    </div>
  </div>
</section>

<!-- Main Form Section -->
<section class="form-section" id="process">
  <div class="card form-card">
    <div class="card-header">
      <h2 class="card-title">&#x1F4DA; Process a Lecture</h2>
      <p class="card-desc">Enter your Panopto lecture URL below to generate notes</p>
    </div>

    <%= form_with url: process_lecture_path, method: :post, local: true, class: "lecture-form", id: "lectureForm" do |f| %>
      <div class="form-group">
        <label for="panopto_url" class="form-label">
          <span class="label-icon">&#x1F517;</span> Panopto Lecture URL
          <span class="required">*</span>
        </label>
        <input type="url" name="panopto_url" id="panopto_url"
               class="form-input"
               placeholder="https://university.hosted.panopto.com/Panopto/Pages/Viewer.aspx?id=..."
               required>
        <span class="form-hint">Paste the full URL from your Panopto lecture viewer</span>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="username" class="form-label">
            <span class="label-icon">&#x1F464;</span> Username
            <span class="optional">(optional)</span>
          </label>
          <input type="text" name="username" id="username"
                 class="form-input"
                 placeholder="Your Panopto username">
        </div>
        <div class="form-group">
          <label for="password" class="form-label">
            <span class="label-icon">&#x1F512;</span> Password
            <span class="optional">(optional)</span>
          </label>
          <input type="password" name="password" id="password"
                 class="form-input"
                 placeholder="Your Panopto password">
        </div>
      </div>

      <!-- Advanced Options -->
      <details class="options-panel">
        <summary class="options-toggle">
          <span class="toggle-icon">&#x2699;&#xFE0F;</span>
          <span>Advanced Options</span>
          <span class="toggle-arrow">&#x25BC;</span>
        </summary>

        <div class="options-content">
          <div class="form-group">
            <label for="format" class="form-label">Output Format</label>
            <div class="select-wrapper">
              <select name="format" id="format" class="form-select">
                <option value="markdown">&#x1F4DD; Markdown (.md)</option>
                <option value="html">&#x1F310; HTML (.html)</option>
                <option value="text">&#x1F4C4; Plain Text (.txt)</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="summary_type" class="form-label">Summary Type</label>
            <div class="select-wrapper">
              <select name="summary_type" id="summary_type" class="form-select">
                <option value="brief">Brief Summary</option>
                <option value="detailed">Detailed Summary</option>
                <option value="key_points">Key Points Only</option>
              </select>
            </div>
          </div>

          <div class="checkbox-grid">
            <label class="checkbox-card">
              <input type="checkbox" name="include_students" value="1">
              <div class="checkbox-content">
                <span class="checkbox-icon">&#x1F64B;</span>
                <span class="checkbox-label">Include Student Q&amp;A</span>
              </div>
            </label>

            <label class="checkbox-card">
              <input type="checkbox" name="include_timestamps" value="1">
              <div class="checkbox-content">
                <span class="checkbox-icon">&#x23F0;</span>
                <span class="checkbox-label">Include Timestamps</span>
              </div>
            </label>

            <label class="checkbox-card">
              <input type="checkbox" name="download_slides" value="1" checked>
              <div class="checkbox-content">
                <span class="checkbox-icon">&#x1F5BC;&#xFE0F;</span>
                <span class="checkbox-label">Download Slides</span>
              </div>
            </label>
          </div>
        </div>
      </details>

      <div class="button-row">
        <button type="submit" class="btn btn-primary btn-lg">
          <span class="btn-icon">&#x1F680;</span>
          Generate Full Notes
        </button>
        <button type="submit" formaction="<%= lecture_summary_path %>" class="btn btn-secondary btn-lg">
          <span class="btn-icon">&#x1F4DD;</span>
          Quick Summary
        </button>
      </div>
    <% end %>
  </div>
</section>

<!-- Features Section -->
<section class="features-section" id="features">
  <h2 class="section-title">Why LectureSnipe?</h2>
  <p class="section-subtitle">Everything you need to ace your lectures</p>

  <div class="features-grid">
    <div class="feature-card">
      <div class="feature-icon">&#x1F9E0;</div>
      <h3 class="feature-title">Smart Speaker Detection</h3>
      <p class="feature-desc">AI-powered detection distinguishes professor lectures from student questions and filters out noise automatically.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">&#x1F4CA;</div>
      <h3 class="feature-title">Multiple Formats</h3>
      <p class="feature-desc">Export your notes as Markdown, HTML, or plain text. Perfect for any workflow or study tool.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">&#x1F5BC;&#xFE0F;</div>
      <h3 class="feature-title">Slide Extraction</h3>
      <p class="feature-desc">Automatically download and embed lecture slides right alongside your transcript notes.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">&#x23F1;&#xFE0F;</div>
      <h3 class="feature-title">Timestamps</h3>
      <p class="feature-desc">Optional timestamps let you jump back to the exact moment in the video for review.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">&#x1F4DD;</div>
      <h3 class="feature-title">Summaries</h3>
      <p class="feature-desc">Generate brief, detailed, or key-point summaries to quickly review before exams.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">&#x1F512;</div>
      <h3 class="feature-title">Authenticated Access</h3>
      <p class="feature-desc">Optionally provide credentials to access locked or private Panopto lectures.</p>
    </div>
  </div>
</section>

<!-- How It Works Section -->
<section class="how-section" id="how-it-works">
  <h2 class="section-title">How It Works</h2>
  <p class="section-subtitle">Three simple steps to perfect notes</p>

  <div class="steps-grid">
    <div class="step-card">
      <div class="step-number">1</div>
      <h3 class="step-title">Paste Your URL</h3>
      <p class="step-desc">Copy the Panopto lecture URL from your browser and paste it into the form above.</p>
    </div>
    <div class="step-connector">&#x2192;</div>
    <div class="step-card">
      <div class="step-number">2</div>
      <h3 class="step-title">We Process It</h3>
      <p class="step-desc">LectureSnipe fetches the transcript, detects speakers, downloads slides, and generates notes.</p>
    </div>
    <div class="step-connector">&#x2192;</div>
    <div class="step-card">
      <div class="step-number">3</div>
      <h3 class="step-title">Download Notes</h3>
      <p class="step-desc">Get your beautifully formatted notes ready for studying, reviewing, or sharing.</p>
    </div>
  </div>
</section>
